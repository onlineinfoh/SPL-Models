# Patient data. Available on reasonable request, see data/README.md
data/*
!data/README.md
binary_classification/labels/*
tmp_test_latest_external/
test/tmp_in/
test/tmp_out/
test/gt/
test/benign/
test/malignant/
.tmp/

# Model weights. Distributed as release assets; SHA256 in
# analysis/checkpoint_manifest.json
**/*.pth
**/*.pt
**/*.ckpt
release_assets/

# Generated image outputs and intermediate arrays, regenerable from the scripts
analysis/masks_locked/
binary_classification/heatmaps_tight/
seg-model-training/nnunet/nnUNet_raw*/
seg-model-training/nnunet/nnUNet_preprocessed/
seg-model-training/nnunet/nnUNet_cropped_data/

# nnU-Net training output: keep the configuration, training log and progress
# curve; exclude the per-case validation predictions (1.5 GB)
seg-model-training/nnunet/nnUNet_results/**/validation/
seg-model-training/nnunet/nnUNet_results/**/*.npz
seg-model-training/nnunet/nnUNet_results/**/*.npy
seg-model-training/nnunet/nnUNet_results/**/*.nii.gz
seg-model-training/nnunet/nnUNet_results/**/*.pkl

# Third-party framework source trees. Versions pinned in
# analysis/environment_lock.txt.
# The two trees carrying an README_SPL.md exclude their contents rather than
# themselves; git will not descend into an excluded directory, so a negation
# under a `dir/` pattern never takes effect.
nnUNet/
seg-model-training/UNetPlusPlus/
seg-model-training/Pytorch-UNet/*
seg-model-training/DeepLabV3Plus-Pytorch/*
!seg-model-training/*/README_SPL.md

# Environments and caches
nnunet-env/
nnunet_v1/
__pycache__/
*.pyc
**/wandb/

# Local working notes
_private_response/

# Local working files
test/
**/*.log

# Revision-era working artifacts. Not part of the reported pipeline; retained
# on the authors' machine only. See docs/CHANGES_AND_REMOVALS.md.
protocol/
analysis/masks_locked_v2/
seg-model-training/nnunet/predicted_masks_v2/
seg-model-training/nnunet/nnUNet_results/Dataset001_lungval/
