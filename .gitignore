# Patient data. Available on reasonable request, see data/README.md
data/*
!data/README.md
binary_classification/labels/*
tmp_test_latest_external/
test/tmp_in/
test/tmp_out/
test/gt/
test/benign/
test/malignant/
.tmp/

# Model weights. Distributed as release assets; SHA256 in
# analysis/checkpoint_manifest.json
**/*.pth
**/*.pt
**/*.ckpt
release_assets/

# Generated image outputs and intermediate arrays, regenerable from the scripts
analysis/masks_locked/
binary_classification/heatmaps_tight/
seg-model-training/nnunet/nnUNet_raw*/
seg-model-training/nnunet/nnUNet_preprocessed/
seg-model-training/nnunet/nnUNet_cropped_data/

# nnU-Net training output: keep the configuration, training log and progress
# curve; exclude the per-case validation predictions (1.5 GB)
seg-model-training/nnunet/nnUNet_results/**/validation/
seg-model-training/nnunet/nnUNet_results/**/*.npz
seg-model-training/nnunet/nnUNet_results/**/*.npy
seg-model-training/nnunet/nnUNet_results/**/*.nii.gz
seg-model-training/nnunet/nnUNet_results/**/*.pkl

# Third-party framework source trees. Versions pinned in
# analysis/environment_lock.txt
nnUNet/
seg-model-training/UNetPlusPlus/
seg-model-training/Pytorch-UNet/
seg-model-training/DeepLabV3Plus-Pytorch/
!seg-model-training/*/README_SPL.md

# Environments and caches
nnunet-env/
nnunet_v1/
__pycache__/
*.pyc
**/wandb/

# Local working notes
_private_response/

# Scratch environment logs only. This rule was previously `**/*.log`, which
# also excluded analysis/logs/train_locked_sweep.log, the console record of the
# internal-only architecture sweep. That file is tracked; see DISCLOSURE.md.
nnunet-env/**/*.log
**/wandb/**/*.log

# ---------------------------------------------------------------------------
# Locked re-analysis: derived artifacts, regenerable from the deposited code
# ---------------------------------------------------------------------------
# Predicted masks are derived from patient images and are treated like the
# source data. Regenerate with predict_all_cohorts.sh and run_seg_inference.py.
analysis/masks_locked_v2/
seg-model-training/nnunet/predicted_masks_v2/

# nnU-Net working directories for the retrained dataset
seg-model-training/nnunet/nnUNet_raw/Dataset001_lungval/
seg-model-training/nnunet/nnUNet_preprocessed/Dataset001_lungval/
seg-model-training/nnunet/nnUNet_results/**/validation/

# Grad-CAM overlays: 2118 images, regenerable with binary_classification/heatmap.py
protocol/results/heatmaps/

# Model weights for the locked runs (see also the **/*.pth rule above)
protocol/runs/**/*.pth
seg-model-training/unet_locked/*.pth

# Console transcripts. The structured training logs ARE tracked.
seg-model-training/unet_locked/console.log
seg-model-training/deeplab_locked/console.log
seg-model-training/nnunet/predict.log
seg-model-training/nnunet/rebuild.log
protocol/finalize.log
protocol/watchdog.log
protocol/sweep_console.log
protocol/results/heatmap.log
